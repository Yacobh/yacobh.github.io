# --- Dependencias y caché de build ---
node_modules/
.shadow-cljs/
.cpcache/
out/
target/
classes/
checkouts/

# --- Artefactos shadow-cljs / ClojureScript (dev) ---
# El sitio en GitHub Pages usa public/js/app.js (+ CSS).
# No versionar el runtime de desarrollo ni metadatos de compile.
public/js/cljs-runtime/
public/js/manifest.edn
public/js/*.js.map
*.js.map

# --- Herramientas / IDE ---
# .clj-kondo/config.edn SÍ se versiona (config compartida de lint); solo se ignora su caché.
.clj-kondo/.cache/
.lsp/
.calva/
.nrepl-port
.lein-*
.repl/
*.log

# --- Herramientas de agente / ahorro de tokens ---
# graphify-out/ es el directorio de TRABAJO de la herramienta (se regenera con
# `graphify update .`); el snapshot citable vive en project-memory/graph/.
# Ver project-memory/GRAPHIFY_INTEGRATION_GUIDE.md.
graphify-out/
# .obsidian/ es configuración personal del Vault (un solo desarrollador hoy).
# Ver project-memory/OBSIDIAN_WORKSPACE_GUIDE.md §3.
.obsidian/

# --- Entorno y secretos ---
.env
.env.*
!.env.example

# --- Supabase CLI (estado local de `supabase link`, sin secretos: versiones de
# servicio y el project ref, pero es cache de máquina, no fuente de verdad) ---
supabase/.temp/
supabase/.branches/

# --- OS ---
.DS_Store
Thumbs.db

# --- Clojure / Lein residual ---
pom.xml
pom.xml.asc
profiles.clj
*.jar
*.class

# --- Local / personal ---
src/universo/user.cljs
