(defn my-avg [n]
  (loop [acc-b 0
         counter-b 0
         acc-r 0
         counter-r 0
         acc-g 0
         counter-g 0
         counter n
         list (take n inf-fake-user)]
    (if (= 0 counter)
      (println "avg-b: " (/ acc-b n) " avg-g: " (/ acc-g n) " avg-r: " (/ acc-r n) " and n = " n)
      (recur (if (= "blue" (:favorite-color (first list))) (+ acc-b (:height (first list)) ) acc-b )
             (if (= "blue" (:favorite-color (first list))) (inc counter-b) counter-b)
             (if (= "red" (:favorite-color (first list))) (+ acc-r (:height (first list)) ) acc-r )
             (if (= "red" (:favorite-color (first list))) (inc counter-r) counter-r)
             (if (= "green" (:favorite-color (first list))) (+ acc-g (:height (first list)) ) acc-g )
             (dec counter)
             (rest list)))))
