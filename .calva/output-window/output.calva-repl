(defn my-avg [n]

  (loop [acc-b 0
         ;acc-r 0
         ;acc-g 0
         counter n
         list (take n inf-fake-user)]
    (if (= 0 counter)
      (println "avg-b" (/ avg-b n))
      (recur (if (= "blue" (:favorite-color (first list))) (+ acc-b (:height (first list)) ) acc-b )))))
(defn my-avg [n]

  (loop [acc-b 0
         ;acc-r 0
         ;acc-g 0
         counter n
         list (inf-fake-user n)]
